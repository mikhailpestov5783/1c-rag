#Область ОбработкаСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодключитьОбработчикОжидания("ОбновитьЧат", 1);
КонецПроцедуры

#КонецОбласти

#Область ОбработкаКомандФормы

&НаКлиенте
Процедура Отправить(Команда)
	Если Не ЗначениеЗаполнено(ВводСообщения) Тогда
		Возврат;
	КонецЕсли;
	
	ВопросБоту(ВводСообщения);
	ВводСообщения = "";
	Элементы.Чат.Обновить();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Процедура ВопросБоту(Сообщение)
	Чатбот.ЗарегистрироватьСообщение(Сообщение);
	
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(Сообщение);
	
	ФоновыеЗадания.Выполнить("Чатбот.ВопросБоту", ПараметрыЗадания,, "Вопрос боту");
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЧат()
	Элементы.Чат.Обновить();
КонецПроцедуры

#КонецОбласти
