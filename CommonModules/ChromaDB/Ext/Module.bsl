Процедура ИнициироватьБазу() Экспорт
	Клиент = Настройки.ПолучитьHTTPСоединение("Chroma");
	Если Клиент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Тело = СформироватьТелоЗапроса();
	
	Заголовки = Новый Соответствие;
	Заголовки["Content-Type"] = "application/json";
	Запрос = Новый HTTPЗапрос("/api/v2/tenants", Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело);
	
	РезультатЗапроса = Клиент.ВызватьHTTPМетод("POST", Запрос);
	
	Запрос = Новый HTTPЗапрос("/api/v2/tenants/default/databases", Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело);
	
	РезультатЗапроса = Клиент.ВызватьHTTPМетод("POST", Запрос);
	
	Тело = СформироватьТелоЗапросаКоллекции();
	
	Запрос = Новый HTTPЗапрос("/api/v2/tenants/default/databases/default/collections", Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело);
	
	РезультатЗапроса = Клиент.ВызватьHTTPМетод("POST", Запрос);
	Если РезультатЗапроса.КодСостояния = 200 Тогда
		ТелоОтвета = РезультатЗапроса.ПолучитьТелоКакСтроку();
		ДанныеОтвета = ПрочитатьОтвет(ТелоОтвета);
		Настройки.УстановитьChromaКоллекцию(ДанныеОтвета["id"]);
	КонецЕсли;
КонецПроцедуры

Функция СформироватьТелоЗапроса()
	Тело = Новый ЗаписьJSON;
	Тело.УстановитьСтроку();
	Данные = Новый Структура;
	Данные.Вставить("name", "default");
	ЗаписатьJSON(Тело, Данные);
	Возврат Тело.Закрыть();
КонецФункции

Функция СформироватьТелоЗапросаКоллекции()
	Тело = Новый ЗаписьJSON;
	Тело.УстановитьСтроку();
	Данные = Новый Структура;
	Данные.Вставить("name", "rag");
	Данные.Вставить("get_or_create",Истина);
	ЗаписатьJSON(Тело, Данные);
	Возврат Тело.Закрыть();
КонецФункции

Функция ПрочитатьОтвет(ОбъектJSON)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ОбъектJSON);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции
