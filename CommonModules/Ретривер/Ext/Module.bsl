#Область ПрограммныйИнтерфейс

Процедура ЗагрузитьФайлВСистему(АдресВХранилище, Имя, Расширение) Экспорт
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВХранилище);
	Путь = Константы.КаталогДокументов.Получить() + "\" + Имя;
	ДвоичныеДанные.Записать(Путь);
	
	Текст = ПрочитатьДокумент(Путь, Расширение);
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат
	КонецЕсли;
	Чанки = РазбитьТекстНаЧанки(Текст);
	Эмбеддинги = ПросчитатьЭмбеддинги(Чанки, Имя);
	
	Адрес = СтрШаблон("/api/v2/tenants/default/databases/default/collections/%1/add", Настройки.ПолучитьChromaКоллекцию());
	HTTPКлиент.ВыполнитьPOSTЗапрос(Адрес, Эмбеддинги, Истина);
	СоздатьНовуюЗаписьДокумент(Путь, Имя, Эмбеддинги["ids"]);
КонецПроцедуры

Процедура УдалитьФайлИзСистемы(Идентификаторы) Экспорт
	Тело = Новый Структура;
	Тело.Вставить("ids", Идентификаторы);
	Адрес = СтрШаблон("/api/v2/tenants/default/databases/default/collections/%1/delete", Настройки.ПолучитьChromaКоллекцию());
	HTTPКлиент.ВыполнитьPOSTЗапрос(Адрес, Тело, Истина);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьДокумент(Путь, Расширение)
	Если Расширение = ".txt" Тогда
		Документ = Новый ТекстовыйДокумент;
		Документ.Прочитать(Путь, "UTF-8");
		Возврат Документ.ПолучитьТекст();
	КонецЕсли;
КонецФункции

Функция РазбитьТекстНаЧанки(Знач Текст)
	РазмерЧанка = 1000;
	НахлестЧанков = 200;
	
	Размер = СтрДлина(Текст);
	НачалоЧанка = 1;
	КрайЧанка = РазмерЧанка;
	Результат = Новый Массив;
	
	Пока Размер > КрайЧанка Цикл
		Чанк = Сред(Текст, НачалоЧанка, РазмерЧанка);
		Результат.Добавить(Чанк);
		НачалоЧанка = КрайЧанка - НахлестЧанков;
		КрайЧанка = НачалоЧанка + РазмерЧанка;
	КонецЦикла;
	
	Чанк = Сред(Текст, НачалоЧанка);
	Результат.Добавить(Чанк);
	
	Возврат Результат;
КонецФункции

Функция ПросчитатьЭмбеддинги(Чанки, Имя)
	Результат = Новый Структура;
	Результат.Вставить("ids", Новый Массив);
	Результат.Вставить("embeddings", Новый Массив);
	Результат.Вставить("documents", Новый Массив);
	НомерЧанка = 1;
	
	Данные = Новый Структура;
	Данные.Вставить("model", Настройки.ПолучитьEmbeddingМодель());
	Данные.Вставить("input", "");
	
	Для Каждого Чанк Из Чанки Цикл
		Результат.ids.Добавить(СтрШаблон("%1(%2)", Имя, НомерЧанка));
		Данные.input = Чанк;
		Эмбеддинг = HTTPКлиент.ВыполнитьPOSTЗапрос("/api/embed", Данные);
		Результат.embeddings.Добавить(Эмбеддинг["embeddings"][0]);
		Результат.documents.Добавить(Чанк);
		НомерЧанка = НомерЧанка + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура СоздатьНовуюЗаписьДокумент(Путь, Имя, Идентификаторы)
	НоваяЗапись = Справочники.Документы.СоздатьЭлемент();
	НоваяЗапись.АбсолютныйПуть = Путь;
	НоваяЗапись.Наименование = Имя;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Ид = НоваяЗапись.ИдентификаторыЧанков.Добавить();
		Ид.Идентификатор = Идентификатор;
	КонецЦикла;
	НоваяЗапись.Записать();
КонецПроцедуры

#КонецОбласти