
Процедура ЗарегистрироватьСообщение(Сообщение, СообщениеБота = Ложь) Экспорт
	МенеджерЗаписи = РегистрыСведений.ИсторияСообщений.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = ТекущаяДата();
	МенеджерЗаписи.СообщениеБота = СообщениеБота;
	МенеджерЗаписи.Сообщение = Сообщение;
	МенеджерЗаписи.Записать(Ложь);
КонецПроцедуры

Процедура ВопросБоту(Текст) Экспорт
	Данные = СформироватьСтруктуруДанныхЭмбеддинг(Текст);
	ВопросЭмбеддинг =  HTTPКлиент.ВыполнитьPOSTЗапрос("/api/embed", Данные);
	
	Адрес = СтрШаблон("/api/v2/tenants/default/databases/default/collections/%1/query", Настройки.ПолучитьChromaКоллекцию());
	Данные = СформироватьСтруктуруДанныхЗапросВВекторнуюБазу(ВопросЭмбеддинг["embeddings"]);
	ДокументОтвет = HTTPКлиент.ВыполнитьPOSTЗапрос(Адрес, Данные, Истина);
	
	Если ДокументОтвет["documents"] = Неопределено Или ДокументОтвет["documents"].Количество() = 0 Тогда
		Возврат; 
	КонецЕсли;
	Документ = ДокументОтвет["documents"][0][0];
	
	Данные = СформироватьСтруктуруДанныхВопросБоту(Текст, Документ);
	Ответ = HTTPКлиент.ВыполнитьPOSTЗапрос("/api/chat", Данные);
	ЗарегистрироватьСообщение(Ответ["message"]["content"], Истина);
КонецПроцедуры

Функция СформироватьСтруктуруДанныхВопросБоту(Текст, Документ)
	Данные = Новый Структура;
	Данные.Вставить("model", Настройки.ПолучитьLLMМодель());
	СообщениеМассив = Новый Массив;
	
	Сообщение = Новый Структура;
	Сообщение.Вставить("role", "system");
	Сообщение.Вставить("content", СтрШаблон("%1 %2", ПолучитьПромпт(), Документ));
	СообщениеМассив.Добавить(Сообщение);
	
	Сообщение = Новый Структура;
	Сообщение.Вставить("role", "user");
	Сообщение.Вставить("content", Текст);
	СообщениеМассив.Добавить(Сообщение);
	
	Данные.Вставить("messages", СообщениеМассив);
	Данные.Вставить("stream", Ложь);
	Возврат Данные;
КонецФункции

Функция СформироватьСтруктуруДанныхЭмбеддинг(Текст)
	Данные = Новый Структура;
	Данные.Вставить("model", Настройки.ПолучитьEmbeddingМодель());
	Данные.Вставить("input", Текст);
	Возврат Данные;
КонецФункции

Функция СформироватьСтруктуруДанныхЗапросВВекторнуюБазу(Эмбеддинг)
	Данные = Новый Структура;
	Данные.Вставить("query_embeddings", Эмбеддинг);
	Данные.Вставить("n_results", 1);
	Возврат Данные;
КонецФункции

Функция ПолучитьПромпт()
	Возврат "При генерации ответа, опирайся на приложенные ниже данные" + Символы.ПС;
КонецФункции
