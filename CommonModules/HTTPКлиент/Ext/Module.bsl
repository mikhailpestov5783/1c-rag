#Область ПрограммныйИнтерфейс

Функция ВыполнитьPOSTЗапрос(Адрес, СтруктураДанных, Chroma = Ложь) Экспорт
	Если Chroma Тогда
		Клиент = Настройки.ПолучитьHTTPСоединение("Chroma");
	Иначе
		Клиент = Настройки.ПолучитьHTTPСоединение("HTTP");
	КонецЕсли;
	
	Тело = СформироватьТелоЗапроса(СтруктураДанных);
	
	Заголовки = Новый Соответствие;
	Заголовки["Content-Type"] = "application/json";
	Запрос = Новый HTTPЗапрос(Адрес, Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело);
	
	Результат = Клиент.ВызватьHTTPМетод("POST", Запрос);
	
	Если Результат.КодСостояния = 201 ИЛИ Результат.КодСостояния = 200 Тогда
		ТелоОтвета = Результат.ПолучитьТелоКакСтроку();
		Возврат ПрочитатьОтвет(ТелоОтвета);
	Иначе
		ВызватьИсключение(Результат.ПолучитьТелоКакСтроку());
	КонецЕсли;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьТелоЗапроса(СтруктураДанных, Параметры = Неопределено)
	Тело = Новый ЗаписьJSON;
	Если Параметры = Неопределено Тогда
		Параметры = Новый ПараметрыЗаписиJSON;
	КонецЕсли;
	Тело.УстановитьСтроку(Параметры);
	ЗаписатьJSON(Тело, СтруктураДанных);
	Возврат Тело.Закрыть();
КонецФункции

Функция ПрочитатьОтвет(СтрокаJSON)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции

#КонецОбласти
