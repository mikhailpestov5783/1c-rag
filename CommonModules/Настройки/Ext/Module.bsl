Функция ПолучитьHTTPСоединение(ТипСоединения) Экспорт
	Если ТипСоединения = "HTTP" Тогда
		URL = Константы.LLM_URL.Получить();
	ИначеЕсли ТипСоединения = "Chroma" Тогда
		URL = Константы.ChromaURL.Получить();
	Иначе
		Возврат Неопределено
	КонецЕсли;
	Если Не ЗначениеЗаполнено(URL) Тогда
		Возврат Неопределено
	КонецЕсли;
	МассивПараметровURL = СтрРазделить(URL, ":");
	Возврат Новый HTTPСоединение(МассивПараметровURL[0], Число(МассивПараметровURL[1]),,,,60);
КонецФункции

