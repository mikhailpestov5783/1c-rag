
&НаКлиенте
Процедура Загрузить(Команда)
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗагрузкиФайла", ЭтотОбъект);
	НачатьПомещениеФайлаНаСервер(ОписаниеОповещения,,,,,УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗагрузкиФайла(ОписаниеФайла, ДополнительныеПараметры) Экспорт
	Если ОписаниеФайла <> Неопределено Тогда
		Адрес = ОписаниеФайла.Адрес;
		Имя = ОписаниеФайла.СсылкаНаФайл.Имя;
		Расширение = ОписаниеФайла.СсылкаНаФайл.Расширение;
		Если Расширение <> ".txt" Тогда 
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Поддерживаются только документы формата txt";
			Сообщение.Сообщить();
			Возврат;
		КонецЕсли;
		Ретривер.ЗагрузитьФайлВСистему(Адрес, Имя, Расширение);
		Элементы.Список.Обновить();
	КонецЕсли;
КонецПроцедуры

